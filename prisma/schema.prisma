generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id           String    @id @default(uuid()) @db.VarChar(36)
  isActive     Boolean   @default(true)
  visible      Boolean   @default(true)
  username     String
  email        String
  phoneNumber  String
  password     String
  profile      String?
  background   String?
  role         EUserRole
  block        Boolean   @default(false)
  loginVersion Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  Company      Company[]
  Jobber       Jobber[]
  Review       Review[]
}

model Course {
  id               String          @id @default(uuid()) @db.VarChar(36)
  isActive         Boolean         @default(true)
  visible          Boolean         @default(false)
  name             String
  postUsageCount   Int             @default(0)
  jobberUsageCount Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  JobberProfile    JobberProfile[]
  PostCourse       PostCourse[]
}

model Major {
  id               String          @id @default(uuid()) @db.VarChar(36)
  isActive         Boolean         @default(true)
  visible          Boolean         @default(false)
  name             String
  postUsageCount   Int             @default(0)
  jobberUsageCount Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  JobberProfile    JobberProfile[]
  PostMajor        PostMajor[]
}

model EducationalInstitution {
  id                       String                     @id @default(uuid()) @db.VarChar(36)
  isActive                 Boolean                    @default(true)
  visible                  Boolean                    @default(false)
  name                     String
  postUsageCount           Int                        @default(0)
  jobberUsageCount         Int                        @default(0)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  JobberProfile            JobberProfile[]
  PostEducationInstitution PostEducationInstitution[]
}

model EducationLevel {
  id                 String               @id @default(uuid()) @db.VarChar(36)
  isActive           Boolean              @default(true)
  visible            Boolean              @default(false)
  name               String
  postUsageCount     Int                  @default(0)
  jobberUsageCount   Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  JobberProfile      JobberProfile[]
  PostEducationLevel PostEducationLevel[]
}

model Skill {
  id                         String                       @id @default(uuid()) @db.VarChar(36)
  isActive                   Boolean                      @default(true)
  visible                    Boolean                      @default(false)
  name                       String
  postUsageCount             Int                          @default(0)
  jobberUsageCount           Int                          @default(0)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  JobberSkill                JobberSkill[]
  PostJobPositionDetailSkill PostJobPositionDetailSkill[]
}

model JobPosition {
  id                    String                  @id @default(uuid()) @db.VarChar(36)
  isActive              Boolean                 @default(true)
  visible               Boolean                 @default(false)
  name                  String
  postUsageCount        Int                     @default(0)
  jobberUsageCount      Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  PostJobPositionDetail PostJobPositionDetail[]
}

model BusinessModel {
  id                String    @id @default(uuid()) @db.VarChar(36)
  isActive          Boolean   @default(true)
  visible           Boolean   @default(false)
  name              String
  companyUsageCount Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  Company           Company[]
}

model JobberStatus {
  id               String   @id @default(uuid()) @db.VarChar(36)
  isActive         Boolean  @default(true)
  visible          Boolean  @default(false)
  name             String
  jobberUsageCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  Jobber           Jobber[]
}

model Jobber {
  id            String         @id @default(uuid()) @db.VarChar(36)
  isVerify      Boolean        @default(false)
  isActive      Boolean        @default(true)
  statusId      String
  memberId      String
  gender        EGender
  firstName     String
  lastName      String
  birthday      DateTime       @db.Date
  nationality   String
  ethnicity     String
  religion      String
  bProvince     String
  bDistrict     String
  bVillage      String
  cProvince     String
  cDistrict     String
  cVillage      String
  docImage      String[]
  reason        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  ApplyForJob   ApplyForJob[]
  member        Member         @relation(fields: [memberId], references: [id])
  status        JobberStatus   @relation(fields: [statusId], references: [id])
  JobberProfile JobberProfile?
  JobberSkill   JobberSkill[]
}

model JobberProfile {
  id                      String                 @id @default(uuid()) @db.VarChar(36)
  jId                     String                 @unique
  elId                    String
  eiId                    String
  mId                     String
  cId                     String
  gpa                     Float
  drivingCardType         String?
  more                    String
  startSalary             Float?
  currency                ECurrency              @default(KIP)
  workDay                 String[]
  checkInTime             DateTime?              @db.Time(6)
  checkOutTime            DateTime?              @db.Time(6)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  course                  Course                 @relation(fields: [cId], references: [id])
  educationalInstitutions EducationalInstitution @relation(fields: [eiId], references: [id])
  educationLevels         EducationLevel         @relation(fields: [elId], references: [id])
  jobber                  Jobber                 @relation(fields: [jId], references: [id])
  major                   Major                  @relation(fields: [mId], references: [id])
}

model Company {
  id              String        @id @default(uuid()) @db.VarChar(36)
  isActive        Boolean       @default(true)
  isVerify        Boolean       @default(false)
  name            String
  bmId            String
  taxPayId        String        @unique
  dob             DateTime      @db.Date
  owner_firstname String
  owner_lastname  String
  province        String
  district        String
  village         String
  docImage        String[]
  reason          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  memberId        String
  bm              BusinessModel @relation(fields: [bmId], references: [id])
  member          Member        @relation(fields: [memberId], references: [id])
  Post            Post[]
}

model Post {
  id                       String                     @id @default(uuid()) @db.VarChar(36)
  isActive                 Boolean                    @default(true)
  cId                      String
  title                    String
  image                    String[]
  minSalary                Decimal
  maxSalary                Decimal
  checkInTime              DateTime
  checkOutTime             DateTime
  gpa                      Float
  currency                 ECurrency
  workday                  String[]
  endDate                  DateTime
  welfare                  String
  more                     String
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  company                  Company                    @relation(fields: [cId], references: [id])
  postCourse               PostCourse[]
  postEducationInstitution PostEducationInstitution[]
  postEducationLevel       PostEducationLevel[]
  postJobPositionDetail    PostJobPositionDetail[]
  postMajor                PostMajor[]
}

model PostCourse {
  pId  String
  crId String
  cr   Course @relation(fields: [crId], references: [id])
  post Post   @relation(fields: [pId], references: [id])

  @@id([pId, crId])
}

model PostMajor {
  pId   String
  mId   String
  major Major  @relation(fields: [mId], references: [id])
  post  Post   @relation(fields: [pId], references: [id])

  @@id([pId, mId])
}

model PostEducationLevel {
  pId            String
  elId           String
  educationLevel EducationLevel @relation(fields: [elId], references: [id])
  post           Post           @relation(fields: [pId], references: [id])

  @@id([pId, elId])
}

model PostEducationInstitution {
  pId  String
  eiId String
  ei   EducationalInstitution @relation(fields: [eiId], references: [id])
  post Post                   @relation(fields: [pId], references: [id])

  @@id([pId, eiId])
}

model PostJobPositionDetail {
  id                         String                       @id @default(uuid()) @db.VarChar(36)
  amount                     Int                          @default(1)
  pId                        String
  jpId                       String
  description                String
  jp                         JobPosition                  @relation(fields: [jpId], references: [id])
  post                       Post                         @relation(fields: [pId], references: [id])
  postJobPositionDetailSkill PostJobPositionDetailSkill[]
}

model PostJobPositionDetailSkill {
  pjpId String
  skId  String
  pjp   PostJobPositionDetail @relation(fields: [pjpId], references: [id])
  sk    Skill                 @relation(fields: [skId], references: [id])

  @@id([pjpId, skId])
}

model ApplyForJob {
  id              String            @id @default(uuid()) @db.VarChar(36)
  isActive        Boolean           @default(true)
  pId             String
  jId             String
  status          String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  jobber          Jobber            @relation(fields: [jId], references: [id])
  AttendInterView AttendInterView[]
}

model AttendInterView {
  id        String      @id @default(uuid()) @db.VarChar(36)
  isActive  Boolean     @default(true)
  status    String
  ajId      String
  data      DateTime
  result    String
  more      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  aj        ApplyForJob @relation(fields: [ajId], references: [id])
}

model Review {
  id        String   @id @default(uuid()) @db.VarChar(36)
  memberId  String
  comment   String
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member    Member   @relation(fields: [memberId], references: [id])
}

model JobberSkill {
  jId    String
  sId    String
  Jobber Jobber @relation(fields: [jId], references: [id])
  Skill  Skill  @relation(fields: [sId], references: [id])

  @@id([jId, sId])
}

enum ECurrency {
  KIP
  USD
  THB
  CNY
}

enum EGender {
  male
  female
  transgender
}

enum EUserRole {
  company
  admin
  jobber
}
